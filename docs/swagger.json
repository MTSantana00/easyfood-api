{
  "openapi": "3.0.0",
  "info": {
    "title": "EasyFood API PRO",
    "description": "Documentação completa da API Monolítica do EasyFood",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "paths": {
    "/restaurants": {
      "get": {
        "summary": "Lista todos os restaurantes",
        "tags": ["Restaurantes"],
        "responses": {
          "200": { "description": "Sucesso" }
        }
      }
    },
    "/orders/revenue": {
      "get": {
        "summary": "Relatório financeiro do restaurante",
        "tags": ["Pedidos & Financeiro"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Relatório gerado com sucesso" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}